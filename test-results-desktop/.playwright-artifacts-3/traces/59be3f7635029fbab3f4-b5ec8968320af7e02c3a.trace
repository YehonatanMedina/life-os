  מערכת ההפעלה — עיצוב\r\n   ========================================================================= */\r\n\r\n:root {\r\n  --bg: #f6f7f9;\r\n  --bg-elev: #ffffff;\r\n  --bg-sunk: #eceef2;\r\n  --card: #ffffff;\r\n  --line: #e2e5ea;\r\n  --line-soft: #eef0f4;\r\n  --text: #16181d;\r\n  --text-dim: #5f6470;\r\n  --text-faint: #6d7280;\r\n  --accent: #5b5bd6;\r\n  --accent-soft: #ececfb;\r\n  --accent-text: #ffffff;\r\n  --on-accent: #ffffff;\r\n  --good: #2b9a66;\r\n  --good-soft: #e4f4ea;\r\n  --warn: #d9730d;\r\n  --warn-soft: #fdf0e3;\r\n  --bad: #d93d42;\r\n  --bad-soft: #fdeaea;\r\n  --shadow: 0 1px 2px rgba(16, 18, 24, .05), 0 4px 14px rgba(16, 18, 24, .06);\r\n  --shadow-lg: 0 10px 40px rgba(16, 18, 24, .16);\r\n  --ring-track: #e6e8ec;\r\n  /* משפחה אחת לכל המערכת: IBM Plex Sans Hebrew לממשק, IBM Plex Mono למספרי\r\n     המכשור — הטיימר, הטבעת והספירה לאחור. אותו קו, שני תפקידים. */\r\n  --font-ui: 'IBM Plex Sans Hebrew', 'Assistant', 'Heebo', -apple-system, BlinkMacSystemFont, 'Segoe UI',\r\n    'Noto Sans Hebrew', Arial, sans-serif;\r\n  --font-num: 'IBM Plex Mono', 'SFMono-Regular', ui-monospace, Menlo, Consolas, monospace;\r\n  /* סולם מרווחים — כל padding ו-gap במערכת נופל על אחד מאלה */\r\n  --s1: 4px;\r\n  --s2: 8px;\r\n  --s3: 12px;\r\n  --s4: 16px;\r\n  --s5: 24px;\r\n  --s6: 32px;\r\n  --r: 14px;\r\n  --r-sm: 10px;\r\n  --r-lg: 20px;\r\n  --nav-h: 62px;\r\n  --header-h: 56px;\r\n}\r\n\r\n:root:not([data-theme='light']) {\r\n  color-scheme: light;\r\n}\r\n\r\n@media (prefers-color-scheme: dark) {\r\n  :root:not([data-theme='light']) {\r\n    --bg: #0e1013;\r\n    --bg-elev: #171a1f;\r\n    --bg-sunk: #0a0c0f;\r\n    --card: #171a1f;\r\n    --line: #282c33;\r\n    --line-soft: #21252b;\r\n    --text: #edeef0;\r\n    --text-dim: #a1a5ad;\r\n    --text-faint: #8b9099;\r\n    --accent: #8b8bf5;\r\n    --accent-soft: #23234a;\r\n    --accent-text: #0e1013;\r\n    --on-accent: #0e1013;\r\n    --good: #46c07f;\r\n    --good-soft: #16301f;\r\n    --warn: #f0913a;\r\n    --warn-soft: #35240f;\r\n    --bad: #ff6369;\r\n    --bad-soft: #3a1a1c;\r\n    --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 4px 14px rgba(0, 0, 0, .3);\r\n    --shadow-lg: 0 10px 40px rgba(0, 0, 0, .6);\r\n    --ring-track: #2b3038;\r\n    color-scheme: dark;\r\n  }\r\n}\r\n\r\n:root[data-theme='dark'] {\r\n  --bg: #0e1013;\r\n  --bg-elev: #171a1f;\r\n  --bg-sunk: #0a0c0f;\r\n  --card: #171a1f;\r\n  --line: #282c33;\r\n  --line-soft: #21252b;\r\n  --text: #edeef0;\r\n  --text-dim: #a1a5ad;\r\n  --text-faint: #8b9099;\r\n  --accent: #8b8bf5;\r\n  --accent-soft: #23234a;\r\n  --accent-text: #0e1013;\r\n  --on-accent: #0e1013;\r\n  --good: #46c07f;\r\n  --good-soft: #16301f;\r\n  --warn: #f0913a;\r\n  --warn-soft: #35240f;\r\n  --bad: #ff6369;\r\n  --bad-soft: #3a1a1c;\r\n  --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 4px 14px rgba(0, 0, 0, .3);\r\n  --shadow-lg: 0 10px 40px rgba(0, 0, 0, .6);\r\n  --ring-track: #2b3038;\r\n  color-scheme: dark;\r\n}\r\n\r\n* { box-sizing: border-box; }\r\n\r\nhtml, body, #root {\r\n  height: 100%;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\nhtml { overflow-x: hidden; }\r\n\r\n/* טקסט שהמשתמש מדביק (קישורים ארוכים) לא ישבור את הפריסה */\r\n.ttl, .sub2, .txt, .empty, .notes { overflow-wrap: anywhere; }\r\n\r\nbody {\r\n  background: var(--bg);\r\n  color: var(--text);\r\n  font-family: var(--font-ui);\r\n  font-size: 15px;\r\n  line-height: 1.5;\r\n  -webkit-font-smoothing: antialiased;\r\n  -webkit-tap-highlight-color: transparent;\r\n  overscroll-behavior-y: none;\r\n}\r\n\r\nbutton, input, select, textarea {\r\n  font: inherit;\r\n  color: inherit;\r\n}\r\n\r\nbutton { cursor: pointer; }\r\n\r\nh1, h2, h3, h4 { margin: 0; font-weight: 600; letter-spacing: -.01em; text-wrap: balance; }\r\nb, strong { font-weight: 600; }\r\n\r\n/* מיקוד מקלדת נראה תמיד */\r\n:focus-visible {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 2px;\r\n  border-radius: 6px;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  *, *::before, *::after {\r\n    animation-duration: .001ms !important;\r\n    animation-iteration-count: 1 !important;\r\n    transition-duration: .001ms !important;\r\n    scroll-behavior: auto !important;\r\n  }\r\n}\r\n\r\n::-webkit-scrollbar { width: 10px; height: 10px; }\r\n::-webkit-scrollbar-thumb { background: var(--line); border-radius: 8px; border: 3px solid var(--bg); }\r\n::-webkit-scrollbar-track { background: transparent; }\r\n\r\n/* =========================================================================\r\n   שלד\r\n   ========================================================================= */\r\n.app {\r\n  display: flex;\r\n  min-height: 100vh;\r\n  min-height: 100dvh;\r\n  flex-direction: column;\r\n}\r\n\r\n.main {\r\n  flex: 1;\r\n  min-width: 0;\r\n  padding: 12px calc(12px + env(safe-area-inset-right)) calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px)\r\n    calc(12px + env(safe-area-inset-left));\r\n}\r\n\r\n.topbar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 40;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  height: calc(var(--header-h) + env(safe-area-inset-top));\r\n  padding: env(safe-area-inset-top) calc(14px + env(safe-area-inset-right)) 0 calc(14px + env(safe-area-inset-left));\r\n  background: color-mix(in srgb, var(--bg) 88%, transparent);\r\n  backdrop-filter: blur(12px);\r\n  border-bottom: 1px solid var(--line-soft);\r\n}\r\n\r\n.topbar h1 { font-size: 17px; }\r\n.topbar .sub { font-size: 12px; color: var(--text-faint); }\r\n/* כפתור עגול בסרגל — הגדרות. מסומן כשהוא המסך הפעיל. */\r\n.iconbtn {\r\n  width: 36px;\r\n  height: 36px;\r\n  flex: 0 0 36px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 999px;\r\n  border: 1px solid transparent;\r\n  background: none;\r\n  color: var(--text-dim);\r\n  padding: 0;\r\n}\r\n.iconbtn .ic { width: 20px; height: 20px; }\r\n.iconbtn:hover { background: var(--bg-sunk); color: var(--text); }\r\n.iconbtn[aria-current='true'] { background: var(--accent-soft); color: var(--accent); }\r\n\r\n.bottomnav {\r\n  position: fixed;\r\n  inset-inline: 0;\r\n  bottom: 0;\r\n  z-index: 50;\r\n  display: grid;\r\n  grid-template-columns: repeat(5, 1fr);\r\n  height: calc(var(--nav-h) + env(safe-area-inset-bottom));\r\n  padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);\r\n  background: color-mix(in srgb, var(--bg-elev) 92%, transparent);\r\n  backdrop-filter: blur(14px);\r\n  border-top: 1px solid var(--line);\r\n}\r\n\r\n.bottomnav button {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 3px;\r\n  background: none;\r\n  border: 0;\r\n  color: var(--text-faint);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  padding: 0;\r\n  transition: color .15s;\r\n}\r\n\r\n.bottomnav button .ic { width: 21px; height: 21px; }\r\n/* הלשונית הפעילה מסומנת גם בצורה — לא רק בצבע */\r\n.bottomnav button { position: relative; }\r\n.bottomnav button[aria-current='true'] { color: var(--accent); font-weight: 800; }\r\n.bottomnav button[aria-current='true']::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  inset-inline-start: 50%;\r\n  transform: translateX(50%);\r\n  width: 26px;\r\n  height: 3px;\r\n  border-radius: 0 0 3px 3px;\r\n  background: var(--accent);\r\n}\r\n.bottomnav button[aria-current='true'] .ic { transform: scale(1.06); }\r\n\r\n.sidebar { display: none; }\r\n\r\n.desk-head { display: none; }\r\n\r\n\r\n.desk-head h1 { font-size: 26px; }\r\n.desk-head .sub { color: var(--text-faint); font-size: 13.5px; margin-top: 2px; }\r\n\r\n/* =========================================================================\r\n   פריטי בסיס\r\n   ========================================================================= */\r\n.card {\r\n  background: var(--card);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r);\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n/* פס צבע בקצה הפנימי. פסאודו־אלמנט ולא border, כי border יחיד על קופסה\r\n   מעוגלת מצייר את קשתות הפינה ונראה כמו סוגר. */\r\n.rail {\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n.rail::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset-block: 0;\r\n  inset-inline-start: 0;\r\n  width: 3px;\r\n  background: var(--rail, var(--accent));\r\n  pointer-events: none;\r\n}\r\n\r\n.card.pad { padding: 14px; }\r\n\r\n.stack { display: flex; flex-direction: column; gap: 12px; }\r\n/* עמוד = ערימה של מקטעים עם נשימה ביניהם; מקטע = כותרת קטנה וכרטיסים צפופים */\r\n.page { display: flex; flex-direction: column; gap: 22px; }\r\n.sec { display: flex; flex-direction: column; gap: 10px; min-width: 0; }\r\n.sec-h {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  padding: 0 4px;\r\n  min-height: 18px;\r\n}\r\n.sec-h h2, .eyebrow {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: var(--text-faint);\r\n  letter-spacing: .03em;\r\n  margin: 0;\r\n}\r\n.sec-h .btn.ghost { margin: -6px -8px; }\r\n/* כותרת בתוך כרטיס — שורה אחת, אותו ריווח בכל המערכת */\r\n.card-h {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  padding: 12px 13px 6px;\r\n}\r\n.card-h b { font-size: 15px; font-weight: 600; }\r\n.card-h .sub2 { font-size: 12px; color: var(--text-faint); margin-top: 1px; }\r\n/* התראה — כרטיס דק עם פס צבע, במקום רקע צבעוני מלא */\r\n.alert {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 10px 13px;\r\n  text-align: start;\r\n  width: 100%;\r\n  color: inherit;\r\n  font: inherit;\r\n}\r\n.alert .txt { flex: 1; min-width: 0; }\r\n.alert b { display: block; font-size: 14px; }\r\n.alert .tiny { margin-top: 1px; }\r\n.row { display: flex; align-items: center; gap: 8px; }\r\n.row.wrap { flex-wrap: wrap; }\r\n.spread { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\r\n.grow { flex: 1; min-width: 0; }\r\n.muted { color: var(--text-dim); }\r\n.faint { color: var(--text-faint); }\r\n.tiny { font-size: 12px; }\r\n.small { font-size: 13px; }\r\n.big { font-size: 30px; font-weight: 800; letter-spacing: -.03em; }\r\n.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n/* גלישה לשתי שורות במקום חיתוך — בטוח יותר מ-ellipsis כשיש מספרים בתוך עברית */\r\n.clamp2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\r\n.center { text-align: center; }\r\n\r\n.section-title {\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  color: var(--text-faint);\r\n  letter-spacing: .03em;\r\n  margin: 2px 2px 0;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.btn {\r\n  white-space: nowrap;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  padding: 9px 14px;\r\n  border-radius: var(--r-sm);\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  color: var(--text);\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  transition: background .12s, border-color .12s, transform .06s;\r\n}\r\n.btn:active { background: var(--bg-sunk); }\r\n@media (hover: hover) {\r\n  .btn:hover { background: var(--bg-sunk); }\r\n}\r\n.btn:active { transform: scale(.98); }\r\n.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }\r\n.btn.primary:hover { filter: brightness(1.08); }\r\n.btn.ghost { background: none; border-color: transparent; color: var(--text-dim); }\r\n.btn.ghost:hover { background: var(--bg-sunk); color: var(--text); }\r\n.btn.danger { color: var(--bad); border-color: var(--line); }\r\n.btn.danger:hover { background: var(--bad-soft); }\r\n.btn.sm { padding: 6px 10px; font-size: 13px; border-radius: 8px; }\r\n.btn.xs { padding: 5px 9px; font-size: 12px; border-radius: 7px; position: relative; }\r\n/* הגדלת אזור הפגיעה בלי לשנות את הגודל הוויזואלי */\r\n.btn.xs::before,\r\n.check::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset: -10px;\r\n}\r\n.check { position: relative; }\r\n.btn.block { width: 100%; }\r\n.btn:disabled { opacity: .45; pointer-events: none; }\r\n\r\n.chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  padding: 3px 9px;\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  background: var(--bg-sunk);\r\n  color: var(--text-dim);\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.chip.on { background: var(--accent-soft); color: var(--accent); }\r\n\r\n.dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 8px; }\r\n\r\n.input, .select, .textarea {\r\n  width: 100%;\r\n  padding: 10px 12px;\r\n  border-radius: var(--r-sm);\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  color: var(--text);\r\n  /* 16px במובייל כדי ש-iOS לא יזום אוטומטית בפוקוס */\r\n  font-size: 16px;\r\n  outline: none;\r\n  transition: border-color .12s, box-shadow .12s;\r\n}\r\n.input:focus, .select:focus, .textarea:focus {\r\n  border-color: var(--accent);\r\n  box-shadow: 0 0 0 3px var(--accent-soft);\r\n}\r\n.textarea { resize: vertical; min-height: 76px; line-height: 1.55; }\r\n.select {\r\n  appearance: none;\r\n  padding-inline-end: 32px;\r\n  background-image: linear-gradient(45deg, transparent 50%, var(--text-faint) 50%),\r\n    linear-gradient(135deg, var(--text-faint) 50%, transparent 50%);\r\n  background-position: calc(100% - 18px) calc(50% + 2px), calc(100% - 13px) calc(50% + 2px);\r\n  background-size: 5px 5px, 5px 5px;\r\n  background-repeat: no-repeat;\r\n}\r\n[dir='rtl'] .select {\r\n  background-position: 13px calc(50% + 2px), 18px calc(50% + 2px);\r\n}\r\n\r\nlabel.field, .field { display: block; }\r\nlabel.field > span, .field > span {\r\n  display: block;\r\n  font-size: 12.5px;\r\n  font-weight: 700;\r\n  color: var(--text-faint);\r\n  margin-bottom: 5px;\r\n}\r\n\r\n/* מתג */\r\n.switch {\r\n  position: relative;\r\n  width: 44px;\r\n  height: 26px;\r\n  border-radius: 999px;\r\n  background: var(--line);\r\n  border: 0;\r\n  flex: 0 0 44px;\r\n  transition: background .18s;\r\n  padding: 0;\r\n}\r\n.switch::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 3px;\r\n  /* inset-inline-start מודע לכיוון — בלי transform שמתהפך ב-RTL */\r\n  inset-inline-start: 3px;\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  background: #fff;\r\n  box-shadow: 0 1px 3px rgba(0, 0, 0, .3);\r\n  transition: inset-inline-start .18s;\r\n}\r\n.switch[aria-checked='true'] { background: var(--accent); }\r\n.switch[aria-checked='true']::after { inset-inline-start: 21px; }\r\n\r\n/* צ׳קבוקס */\r\n.check {\r\n  width: 24px;\r\n  height: 24px;\r\n  flex: 0 0 24px;\r\n  border-radius: 8px;\r\n  border: 2px solid var(--line);\r\n  background: var(--bg-elev);\r\n  display: grid;\r\n  place-items: center;\r\n  color: transparent;\r\n  font-size: 14px;\r\n  font-weight: 800;\r\n  padding: 0;\r\n  transition: background .12s, border-color .12s, color .12s;\r\n}\r\n.check.on { background: var(--good); border-color: var(--good); color: var(--on-accent); }\r\n.check.sm { width: 20px; height: 20px; flex-basis: 20px; border-radius: 6px; font-size: 12px; }\r\n\r\n/* מד התקדמות */\r\n.bar {\r\n  height: 8px;\r\n  border-radius: 999px;\r\n  background: var(--bg-sunk);\r\n  overflow: hidden;\r\n}\r\n.bar > i {\r\n  display: block;\r\n  height: 100%;\r\n  border-radius: 999px;\r\n  background: var(--accent);\r\n  transition: width .35s cubic-bezier(.4, 0, .2, 1);\r\n}\r\n\r\n/* =========================================================================\r\n   מודאל / גיליון\r\n   ========================================================================= */\r\n.scrim {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 100;\r\n  background: rgba(8, 10, 14, .5);\r\n  backdrop-filter: blur(3px);\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: center;\r\n  animation: fade .16s ease;\r\n}\r\n@keyframes fade { from { opacity: 0 } }\r\n@keyframes up { from { transform: translateY(18px); opacity: .4 } }\r\n\r\n/* גיליון בתוך גיליון (בורר תאריך/שעה) */\r\n.scrim .scrim { z-index: 120; }\r\n\r\n.sheet {\r\n  width: 100%;\r\n  max-width: 560px;\r\n  max-height: 92vh;\r\n  max-height: 92dvh;\r\n  overflow-y: auto;\r\n  background: var(--bg-elev);\r\n  border-radius: var(--r-lg) var(--r-lg) 0 0;\r\n  border: 1px solid var(--line);\r\n  border-bottom: 0;\r\n  padding: 8px 16px calc(20px + env(safe-area-inset-bottom));\r\n  animation: up .2s cubic-bezier(.2, .8, .3, 1);\r\n}\r\n.sheet-actions {\r\n  position: sticky;\r\n  bottom: calc(-1 * env(safe-area-inset-bottom));\r\n  z-index: 2;\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin: 14px -16px calc(-1 * (20px + env(safe-area-inset-bottom)));\r\n  padding: 12px 16px calc(16px + env(safe-area-inset-bottom));\r\n  background: var(--bg-elev);\r\n  border-top: 1px solid var(--line-soft);\r\n}\r\n.sheet-actions .spacer { flex: 1; }\r\n\r\n.sheet .grip {\r\n  width: 40px;\r\n  height: 4px;\r\n  border-radius: 999px;\r\n  background: var(--line);\r\n  margin: 6px auto 12px;\r\n}\r\n.sheet h3 { font-size: 18px; margin-bottom: 12px; }\r\n\r\n@media (min-width: 700px) {\r\n  .scrim { align-items: center; }\r\n  .sheet {\r\n    border-radius: var(--r-lg);\r\n    border-bottom: 1px solid var(--line);\r\n    max-height: 86vh;\r\n    max-height: 86dvh;\r\n    padding: 18px 20px 20px;\r\n    box-shadow: var(--shadow-lg);\r\n  }\r\n  .sheet-actions {\r\n    margin: 14px -20px -20px;\r\n    padding: 12px 20px 20px;\r\n  }\r\n  .sheet-actions {\r\n  position: sticky;\r\n  bottom: calc(-1 * env(safe-area-inset-bottom));\r\n  z-index: 2;\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin: 14px -16px calc(-1 * (20px + env(safe-area-inset-bottom)));\r\n  padding: 12px 16px calc(16px + env(safe-area-inset-bottom));\r\n  background: var(--bg-elev);\r\n  border-top: 1px solid var(--line-soft);\r\n}\r\n.sheet-actions .spacer { flex: 1; }\r\n\r\n.sheet .grip { display: none; }\r\n}\r\n\r\n/* =========================================================================\r\n   טבעת אסימונים\r\n   ========================================================================= */\r\n.ring-wrap { position: relative; display: grid; place-items: center; }\r\n.ring-wrap .inner {\r\n  position: absolute;\r\n  display: grid;\r\n  place-items: center;\r\n  text-align: center;\r\n}\r\n.ring-wrap .inner .n {\r\n  font-family: var(--font-num);\r\n  font-size: 32px;\r\n  font-weight: 700;\r\n  letter-spacing: -.05em;\r\n  line-height: 1;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.ring-wrap .inner .l { font-size: 11.5px; color: var(--text-faint); font-weight: 700; margin-top: 3px; }\r\n\r\n/* =========================================================================\r\n   טיימר\r\n   ========================================================================= */\r\n.timer-card { padding: 16px; }\r\n\r\n/* טבעת האסימונים והטיימר זה לצד זה; בטלפון צר הטבעת עולה למעלה\r\n   כדי שהתגיות יקבלו את כל הרוחב */\r\n.dw-row { display: flex; gap: 16px; align-items: center; }\r\n@media (max-width: 470px) {\r\n  .dw-row { flex-direction: column; align-items: stretch; gap: 12px; }\r\n  .dw-row > .ring-wrap { align-self: center; }\r\n  .dw-row .tag-scroll { justify-content: center; }\r\n}\r\n.timer-time {\r\n  font-family: var(--font-num);\r\n  font-variant-numeric: tabular-nums;\r\n  font-size: 42px;\r\n  font-weight: 700;\r\n  letter-spacing: -.05em;\r\n  line-height: 1;\r\n}\r\n.timer-card.live { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow); }\r\n\r\n.pulse { animation: pulse 2.4s ease-in-out infinite; }\r\n@keyframes pulse { 0%, 100% { opacity: 1 } 50% { opacity: .45 } }\r\n\r\n/* =========================================================================\r\n   ספירה לאחור\r\n   ========================================================================= */\r\n.countdowns {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(126px, 1fr));\r\n  gap: 8px;\r\n}\r\n.cd {\r\n  position: relative;\r\n  overflow: hidden;\r\n  padding: 10px 12px 10px 12px;\r\n  padding-inline-start: 15px;\r\n  border-radius: var(--r-sm);\r\n  border: 1px solid var(--line);\r\n  background: var(--card);\r\n}\r\n.cd::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset-block: 0;\r\n  inset-inline-start: 0;\r\n  width: 3px;\r\n  background: var(--rail, var(--accent));\r\n}\r\n.cd .d {\r\n  font-family: var(--font-num);\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  line-height: 1.15;\r\n  letter-spacing: -.04em;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.cd .d span { font-family: var(--font-ui); letter-spacing: 0; }\r\n.cd .t { font-size: 12.5px; color: var(--text-dim); font-weight: 600; margin-top: 1px; }\r\n.cd .t > div {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n  white-space: normal;\r\n}\r\n.cd .w { font-size: 11px; color: var(--text-faint); }\r\n.cd.hot { background: var(--bad-soft); }\r\n\r\n/* =========================================================================\r\n   רשימות\r\n   ========================================================================= */\r\n.list { display: flex; flex-direction: column; }\r\n.item {\r\n  border: 0;\r\n  border-radius: 0;\r\n  color: inherit;\r\n  font: inherit;\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 11px 13px;\r\n  border-bottom: 1px solid var(--line-soft);\r\n  background: none;\r\n  min-height: 48px;\r\n}\r\n.item:last-child { border-bottom: 0; }\r\n.item .txt { flex: 1; min-width: 0; font-size: 14.5px; }\r\n.item .txt .sub2 { font-size: 12px; color: var(--text-faint); margin-top: 1px; }\r\n.item.done .txt > .ttl { text-decoration: line-through; color: var(--text-faint); }\r\n.item .txt .ttl { line-height: 1.35; }\r\n\r\n/* מספרים, שעות וטווחים — תמיד משמאל לימין כדי שלא יתהפכו בעברית */\r\n.ltr {\r\n  direction: ltr;\r\n  unicode-bidi: isolate;\r\n  display: inline-block;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.item.tappable { cursor: pointer; }\r\n.item.tappable:active { background: var(--bg-sunk); }\r\n@media (hover: hover) {\r\n  .item.tappable:hover { background: var(--bg-sunk); }\r\n}\r\n\r\n.empty {\r\n  padding: 26px 14px;\r\n  text-align: center;\r\n  color: var(--text-faint);\r\n  font-size: 13.5px;\r\n}\r\n\r\n/* =========================================================================\r\n   קנבן\r\n   ========================================================================= */\r\n.kanban {\r\n  display: grid;\r\n  gap: 10px;\r\n  grid-template-columns: 1fr;\r\n}\r\n@media (min-width: 900px) {\r\n  .kanban { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; }\r\n}\r\n.kcol {\r\n  background: var(--bg-sunk);\r\n  border-radius: var(--r);\r\n  padding: 8px;\r\n  min-height: 60px;\r\n  border: 1px solid transparent;\r\n  transition: border-color .12s, background .12s;\r\n}\r\n.kcol.over { border-color: var(--accent); background: var(--accent-soft); }\r\n.kcol > h4 {\r\n  font-size: 12.5px;\r\n  color: var(--text-dim);\r\n  padding: 2px 6px 8px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n}\r\n.kcard {\r\n  position: relative;\r\n  overflow: hidden;\r\n  background: var(--card);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-sm);\r\n  padding: 10px 11px;\r\n  margin-bottom: 7px;\r\n  box-shadow: var(--shadow);\r\n  cursor: grab;\r\n}\r\n.kcard::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset-block: 0;\r\n  inset-inline-start: 0;\r\n  width: 3px;\r\n  background: var(--rail, var(--line));\r\n}\r\n.kcard:active { cursor: grabbing; }\r\n.kcard.dragging { opacity: .35; }\r\n.kcard .t {\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n  line-height: 1.35;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n.kcard .m { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 7px; align-items: center; }\r\n\r\n/* =========================================================================\r\n   יומן — רשת חודש\r\n   ========================================================================= */\r\n.cal-head {\r\n  display: grid;\r\n  grid-template-columns: repeat(7, minmax(0, 1fr));\r\n  gap: 1px;\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  color: var(--text-faint);\r\n  text-align: center;\r\n  padding-bottom: 6px;\r\n}\r\n.cal-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(7, minmax(0, 1fr));\r\n  gap: 1px;\r\n  background: var(--line);\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r);\r\n  overflow: hidden;\r\n}\r\n.cal-cell {\r\n  min-width: 0;\r\n  background: var(--card);\r\n  min-height: 86px;\r\n  padding: 4px 5px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  text-align: start;\r\n  border: 0;\r\n  border-radius: 0;\r\n  transition: background .12s;\r\n}\r\n@media (hover: hover) {\r\n  .cal-cell:hover { background: var(--bg-sunk); }\r\n}\r\n.cal-cell:active { background: var(--bg-sunk); }\r\n.cal-cell.out { background: var(--bg-sunk); opacity: .5; }\r\n.cal-cell.today .n { background: var(--accent); color: var(--on-accent); }\r\n.cal-cell .n {\r\n  align-self: flex-start;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  width: 21px;\r\n  height: 21px;\r\n  display: grid;\r\n  place-items: center;\r\n  border-radius: 50%;\r\n}\r\n.cal-cell.sel { box-shadow: inset 0 0 0 2px var(--accent); }\r\n.pill.tinted {\r\n  --c: var(--accent);\r\n  background: color-mix(in srgb, var(--c) 16%, var(--card));\r\n  color: var(--c);\r\n}\r\n.chip.tinted {\r\n  --c: var(--accent);\r\n  background: color-mix(in srgb, var(--c) 16%, var(--card));\r\n  color: var(--c);\r\n}\r\n@media (prefers-color-scheme: dark) {\r\n  :root:not([data-theme='light']) .pill.tinted,\r\n  :root:not([data-theme='light']) .chip.tinted {\r\n    background: color-mix(in srgb, var(--c) 24%, var(--card));\r\n    color: color-mix(in srgb, var(--c) 45%, white);\r\n  }\r\n}\r\n:root[data-theme='dark'] .pill.tinted,\r\n:root[data-theme='dark'] .chip.tinted {\r\n  background: color-mix(in srgb, var(--c) 24%, var(--card));\r\n  color: color-mix(in srgb, var(--c) 45%, white);\r\n}\r\n\r\n.pill {\r\n  font-size: 10.5px;\r\n  padding: 1px 5px;\r\n  border-radius: 5px;\r\n  font-weight: 700;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  line-height: 1.5;\r\n}\r\n@media (max-width: 640px) {\r\n  .cal-cell { min-height: 62px; }\r\n  .pill { font-size: 9.5px; padding: 0 3px; }\r\n}\r\n\r\n/* =========================================================================\r\n   יומן — רשת שעות (שבוע / יום)\r\n   ========================================================================= */\r\n.wk {\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r);\r\n  overflow: hidden;\r\n  background: var(--card);\r\n}\r\n/* הכותרת יושבת מעל גוף הרשת שגולל בפנים — אין צורך ב-sticky\r\n   (ובתוך .wk שיש לו overflow:hidden זה גם היה יוצר מרווח ריק) */\r\n.wk-head {\r\n  display: grid;\r\n  background: var(--card);\r\n  border-bottom: 1px solid var(--line);\r\n}\r\n.wk-head .h {\r\n  padding: 6px 2px;\r\n  text-align: center;\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  color: var(--text-dim);\r\n  border-inline-start: 1px solid var(--line-soft);\r\n}\r\n.wk-head .h.today { color: var(--accent); }\r\n.wk-head .h b { display: block; font-size: 17px; letter-spacing: -.02em; }\r\n.wk-allday {\r\n  display: grid;\r\n  border-bottom: 1px solid var(--line);\r\n  min-height: 24px;\r\n  background: var(--bg-sunk);\r\n}\r\n.wk-allday .c { border-inline-start: 1px solid var(--line-soft); padding: 2px; display: flex; flex-direction: column; gap: 2px; }\r\n.wk-body {\r\n  display: grid;\r\n  position: relative;\r\n  overflow-y: auto;\r\n  padding-top: 8px;\r\n  max-height: 62vh;\r\n  max-height: max(300px, min(62dvh, calc(100dvh - 230px)));\r\n}\r\n.wk-gutter { border-inline-end: 1px solid var(--line); position: relative; }\r\n.wk-gutter .hr {\r\n  position: absolute;\r\n  inset-inline-end: 4px;\r\n  font-size: 10.5px;\r\n  color: var(--text-faint);\r\n  transform: translateY(-6px);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.wk-col {\r\n  position: relative;\r\n  border-inline-start: 1px solid var(--line-soft);\r\n}\r\n.wk-col .hline { position: absolute; inset-inline: 0; border-top: 1px solid var(--line); }\r\n.wk-col .hline.half { border-top: 1px dotted var(--line-soft); }\r\n.wk-col.weekend { background: color-mix(in srgb, var(--bg-sunk) 55%, transparent); }\r\n.wk-now {\r\n  position: absolute;\r\n  inset-inline: 0;\r\n  height: 2px;\r\n  background: var(--bad);\r\n  z-index: 5;\r\n  pointer-events: none;\r\n}\r\n.wk-now::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset-inline-end: -1px;\r\n  top: -4px;\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background: var(--bad);\r\n}\r\n.ev {\r\n  --evc: var(--accent);\r\n  background: color-mix(in srgb, var(--evc) 15%, var(--card));\r\n  color: var(--evc);\r\n  position: absolute;\r\n  inset-inline: 2px;\r\n  border-radius: 7px;\r\n  padding: 2px 6px;\r\n  font-size: 11.5px;\r\n  font-weight: 700;\r\n  line-height: 1.25;\r\n  overflow: hidden;\r\n  cursor: grab;\r\n  /* גלילה אנכית ממשיכה לעבוד גם כשהאצבע על אירוע; הגרירה נפתחת בלחיצה ארוכה */\r\n  touch-action: pan-y;\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n  z-index: 2;\r\n}\r\n.ev::before {\r\n  content: '';\r\n  position: absolute;\r\n  inset-block: 0;\r\n  inset-inline-start: 0;\r\n  width: 3px;\r\n  background: var(--evc);\r\n}\r\n.ev { padding-inline-start: 9px; }\r\n.ev:active { cursor: grabbing; }\r\n.ev.drag { z-index: 9; box-shadow: var(--shadow-lg); opacity: .92; }\r\n.ev .time { font-weight: 600; opacity: .9; font-size: 10.5px; }\r\n.ev .handle {\r\n  position: absolute;\r\n  inset-inline: 0;\r\n  bottom: 0;\r\n  height: 14px;\r\n  cursor: ns-resize;\r\n  touch-action: pan-y;\r\n}\r\n.ev:hover .handle::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset-inline: 30%;\r\n  bottom: 3px;\r\n  height: 2px;\r\n  border-radius: 2px;\r\n  background: currentColor;\r\n  opacity: .5;\r\n}\r\n\r\n@media (prefers-color-scheme: dark) {\r\n  :root:not([data-theme='light']) .ev {\r\n    background: color-mix(in srgb, var(--evc) 24%, var(--card));\r\n    color: color-mix(in srgb, var(--evc) 45%, white);\r\n  }\r\n}\r\n:root[data-theme='dark'] .ev {\r\n  background: color-mix(in srgb, var(--evc) 24%, var(--card));\r\n  color: color-mix(in srgb, var(--evc) 45%, white);\r\n}\r\n\r\n/* =========================================================================\r\n   שונות\r\n   ========================================================================= */\r\n.toast {\r\n  position: fixed;\r\n  inset-inline: 0;\r\n  bottom: calc(var(--nav-h) + env(safe-area-inset-bottom) + 12px);\r\n  z-index: 200;\r\n  display: flex;\r\n  justify-content: center;\r\n  pointer-events: none;\r\n  padding: 0 12px;\r\n}\r\n.toast > div {\r\n  max-width: calc(100% - 84px);\r\n  background: var(--text);\r\n  color: var(--bg);\r\n  border-radius: 999px;\r\n  padding: 9px 18px;\r\n  font-size: 13.5px;\r\n  font-weight: 700;\r\n  box-shadow: var(--shadow-lg);\r\n  pointer-events: auto;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  animation: up .2s;\r\n}\r\n.toast button { background: none; border: 0; color: var(--accent); font-weight: 800; padding: 0; }\r\n@media (min-width: 900px) { .toast { bottom: 22px; } }\r\n\r\n.heat { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }\r\n.heat i {\r\n  display: block;\r\n  aspect-ratio: 1;\r\n  border-radius: 4px;\r\n  background: var(--bg-sunk);\r\n}\r\n\r\n.grid2 { display: grid; grid-template-columns: 1fr; gap: 12px; }\r\n/* מסכים בעמודה אחת — לא נמתחים על כל הרוחב במחשב */\r\n.narrow { width: 100%; }\r\n.grid2 > *, .grid3 > *, .kanban > * { min-width: 0; }\r\n@media (min-width: 900px) {\r\n  .grid2 { grid-template-columns: 1.1fr .9fr; align-items: start; }\r\n  .narrow { max-width: 720px; margin-inline: auto; }\r\n  /* עמודת קנבן ארוכה גוללת בפנים במקום למתוח את כל הלוח */\r\n  .kcol { max-height: 72vh; overflow-y: auto; }\r\n  /* תצוגת יום במחשב — עמודה בעובי סביר, לא על כל הרוחב */\r\n  .wk.single { max-width: 560px; margin-inline: auto; }\r\n}\r\n.grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\r\n\r\n.hstack-scroll {\r\n  max-width: 100%;\r\n  display: flex;\r\n  gap: 8px;\r\n  overflow-x: auto;\r\n  padding-bottom: 4px;\r\n  scrollbar-width: none;\r\n}\r\n.hstack-scroll::-webkit-scrollbar { display: none; }\r\n\r\n\r\n.lock-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 90;\r\n  background: var(--bg);\r\n  overflow-y: auto;\r\n  padding: 20px 16px calc(40px + env(safe-area-inset-bottom));\r\n}\r\n\r\n.qcard { border: 1px solid var(--line); border-radius: var(--r); padding: 13px; background: var(--card); }\r\n.qcard .q { font-size: 15px; font-weight: 700; }\r\n.qcard .h { font-size: 12.5px; color: var(--text-faint); margin: 3px 0 8px; }\r\n\r\n.scorebar { display: flex; gap: 5px; }\r\n.scorebar button {\r\n  flex: 1;\r\n  padding: 9px 0;\r\n  border-radius: 8px;\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n}\r\n.scorebar button.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }\r\n\r\n.pbar { display: flex; align-items: center; gap: 8px; }\r\n\r\n/* עוטף שורות במקום לגלול — אחרת רוב האפשרויות פשוט לא נראות */\r\n.tag-scroll { display: flex; flex-wrap: wrap; gap: 6px; padding: 2px 0; max-width: 100%; }\r\n.tag {\r\n  --tc: var(--accent);\r\n  flex: 0 0 auto;\r\n  padding: 7px 12px;\r\n  border-radius: 999px;\r\n  border: 1px solid color-mix(in srgb, var(--tc) 55%, var(--line));\r\n  background: var(--bg-elev);\r\n  color: color-mix(in srgb, var(--tc) 78%, black);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  white-space: nowrap;\r\n}\r\n@media (prefers-color-scheme: dark) {\r\n  :root:not([data-theme='light']) .tag:not(.on) {\r\n    color: color-mix(in srgb, var(--tc) 55%, white);\r\n    border-color: color-mix(in srgb, var(--tc) 70%, var(--line));\r\n  }\r\n}\r\n:root[data-theme='dark'] .tag:not(.on) {\r\n  color: color-mix(in srgb, var(--tc) 55%, white);\r\n  border-color: color-mix(in srgb, var(--tc) 70%, var(--line));\r\n}\r\n/* רקע ברירת מחדל — כדי ש-.on לא יהיה לבן על לבן כשלא הועבר צבע ישירות */\r\n.tag.on { background: var(--tc); color: var(--on-accent); border-color: transparent; }\r\n\r\n.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\r\n\r\n/* =========================================================================\r\n   תובנות, מעבר שבועי, מצב מיקוד, גרפים\r\n   ========================================================================= */\r\n.ins {\r\n  border: 1px solid var(--line);\r\n  border-inline-start: 3px solid var(--accent);\r\n  border-radius: var(--r-sm);\r\n  padding: 10px 12px;\r\n  background: var(--bg-elev);\r\n}\r\n.ins b { display: block; font-size: 14px; margin-bottom: 2px; }\r\n.ins .small { color: var(--text-dim); line-height: 1.6; }\r\n.ins.good { border-inline-start-color: var(--good); }\r\n.ins.good b { color: var(--good); }\r\n.ins.warn { border-inline-start-color: var(--warn); }\r\n.ins.warn b { color: var(--warn); }\r\n.ins.bad { border-inline-start-color: var(--bad); background: var(--bad-soft); }\r\n.ins.bad b { color: var(--bad); }\r\n\r\n/* המעבר השבועי — מסך מלא עם ראש קבוע ופס שלבים */\r\n.flow {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 300;\r\n  background: var(--bg);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n.flow-head {\r\n  padding: calc(12px + env(safe-area-inset-top)) 14px 10px;\r\n  background: var(--bg-elev);\r\n  border-bottom: 1px solid var(--line);\r\n  flex-shrink: 0;\r\n}\r\n.flow-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  padding: 14px;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n.flow-foot {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 10px 14px calc(10px + env(safe-area-inset-bottom));\r\n  border-top: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  flex-shrink: 0;\r\n}\r\n.steps { display: flex; gap: 4px; margin-top: 10px; }\r\n.steps i { flex: 1; height: 3px; border-radius: 2px; background: var(--line); transition: background .2s; }\r\n.steps i.on { background: var(--accent); }\r\n\r\n/* מצב מיקוד — רק הזמן שנשאר */\r\n.focus {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 400;\r\n  background: var(--bg);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 24px;\r\n}\r\n.focus-x {\r\n  position: absolute;\r\n  top: calc(14px + env(safe-area-inset-top));\r\n  inset-inline-end: 14px;\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  color: var(--text-faint);\r\n  font-size: 15px;\r\n}\r\n.focus-mid { text-align: center; }\r\n.focus-track { font-size: 15px; font-weight: 700; color: var(--text-dim); margin-bottom: 12px; }\r\n.focus-time {\r\n  font-family: var(--font-num);\r\n  font-size: clamp(60px, 21vw, 150px);\r\n  font-weight: 700;\r\n  letter-spacing: -.045em;\r\n  line-height: 1;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.focus-time.over { color: var(--good); }\r\n.focus-sub { margin-top: 14px; color: var(--text-faint); font-size: 13px; }\r\n.focus-paused { margin-top: 8px; color: var(--warn); font-weight: 800; font-size: 13px; }\r\n.focus-actions {\r\n  position: absolute;\r\n  bottom: calc(30px + env(safe-area-inset-bottom));\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n.focus-bar { position: absolute; inset-inline: 0; bottom: 0; height: 3px; background: var(--line-soft); }\r\n.focus-bar i { display: block; height: 100%; background: var(--accent); transition: width 1s linear; }\r\n\r\n/* עמודות ימי השבוע */\r\n.daybars { display: flex; align-items: flex-end; gap: 6px; }\r\n.daybar { flex: 1; min-width: 0; text-align: center; }\r\n.daybar .col { position: relative; height: 104px; display: flex; align-items: flex-end; }\r\n.daybar .fill { width: 100%; border-radius: 6px; }\r\n.daybar .goal { position: absolute; inset-inline: -3px; border-top: 1px dashed var(--text-faint); opacity: .55; }\r\n\r\n/* היסטוריה ארוכה — עמודה לכל יום או שבוע */\r\n.hist { position: relative; display: flex; align-items: flex-end; gap: 2px; height: 124px; }\r\n.hist i { flex: 1 1 0; min-width: 2px; border-radius: 2px; }\r\n.hist .goal-line { position: absolute; inset-inline: 0; border-top: 1px dashed var(--text-faint); opacity: .5; }\r\n\r\n/* דירוג כתבה */\r\n.vote {\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 8px;\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  color: var(--text-faint);\r\n  font-size: 11px;\r\n  line-height: 1;\r\n}\r\n.vote.up { background: var(--good-soft); border-color: var(--good); color: var(--good); }\r\n.vote.down { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }\r\n\r\n/* החלפת תקופה ביומן */\r\n.swipe-in { animation: swipe-fwd .18s ease-out; }\r\n.swipe-in.back { animation-name: swipe-back; }\r\n@keyframes swipe-fwd { from { transform: translateX(-16px); opacity: .5 } }\r\n@keyframes swipe-back { from { transform: translateX(16px); opacity: .5 } }\r\n\r\n/* =========================================================================\r\n   פריסת מחשב — בסוף הקובץ כדי שכללי הבסיס לא יבטלו אותה\r\n   ========================================================================= */\r\n@media (min-width: 900px) {\r\n  .input, .select, .textarea { font-size: 15px; }\r\n  .app { flex-direction: row; }\r\n  .bottomnav { display: none; }\r\n  .main {\r\n    padding: 0 22px 40px;\r\n    max-width: 1120px;\r\n    margin-inline: auto;\r\n    width: 100%;\r\n  }\r\n  .sidebar {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    width: 214px;\r\n    flex: 0 0 214px;\r\n    padding: 18px 12px;\r\n    border-inline-start: 1px solid var(--line);\r\n    background: var(--bg-elev);\r\n    position: sticky;\r\n    top: 0;\r\n    height: 100vh;\r\n    height: 100dvh;\r\n    overflow-y: auto;\r\n  }\r\n  .sidebar .brand {\r\n    padding: 6px 10px 18px;\r\n  }\r\n  .sidebar .brand b { display: block; font-size: 17px; }\r\n  .sidebar .brand span { font-size: 12px; color: var(--text-faint); }\r\n  .sidebar button {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    width: 100%;\r\n    padding: 10px 12px;\r\n    border: 0;\r\n    border-radius: var(--r-sm);\r\n    background: none;\r\n    color: var(--text-dim);\r\n    font-size: 14.5px;\r\n    font-weight: 600;\r\n    text-align: start;\r\n    transition: background .15s, color .15s;\r\n  }\r\n  .sidebar button:hover { background: var(--bg-sunk); color: var(--text); }\r\n  .sidebar button[aria-current='true'] { background: var(--accent-soft); color: var(--accent); }\r\n  .sidebar button .ic { width: 19px; height: 19px; flex: 0 0 19px; }\r\n  .sidebar .foot { margin-top: auto; display: flex; flex-direction: column; gap: 2px; padding-top: 10px; border-top: 1px solid var(--line-soft); }\r\n  .topbar { display: none; }\r\n  .desk-head { display: block; padding: 22px 0 4px; }\r\n}\r\n\r\n/* =========================================================================\r\n   אימונים\r\n   ========================================================================= */\r\n.wk-strip { display: flex; gap: 4px; padding: 6px 13px 10px; }\r\n.wk-strip .wd {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 2px;\r\n  padding: 6px 0;\r\n  border: 1px solid var(--line);\r\n  border-radius: var(--r-sm);\r\n  background: var(--bg-elev);\r\n  min-width: 0;\r\n}\r\n.wk-strip .wd .l { font-size: 10.5px; color: var(--text-faint); font-weight: 700; }\r\n.wk-strip .wd .i { font-size: 14px; line-height: 1; }\r\n.wk-strip .wd.now { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }\r\n.wk-strip .wd.ok { background: var(--good-soft); border-color: var(--good); }\r\n.wk-strip .wd.part { background: var(--warn-soft); border-color: var(--warn); }\r\n.wk-strip .wd:disabled { opacity: 1; }\r\n\r\n.sets { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }\r\n.setchip {\r\n  position: relative;\r\n  min-width: 74px;\r\n  padding: 9px 10px 9px 10px;\r\n  border-radius: var(--r-sm);\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  color: var(--text-faint);\r\n  font-weight: 700;\r\n  font-size: 13.5px;\r\n  font-variant-numeric: tabular-nums;\r\n  text-align: center;\r\n}\r\n.setchip .n {\r\n  position: absolute;\r\n  top: 2px;\r\n  inset-inline-start: 6px;\r\n  font-size: 9.5px;\r\n  font-weight: 800;\r\n  color: var(--text-faint);\r\n  opacity: .8;\r\n}\r\n.setchip.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }\r\n.setchip.edit { box-shadow: 0 0 0 2px var(--accent); }\r\n.setchip.add { min-width: 46px; color: var(--text-dim); font-size: 15px; }\r\n\r\n.set-edit {\r\n  margin-top: 10px;\r\n  padding: 10px;\r\n  border: 1px solid var(--accent);\r\n  border-radius: var(--r-sm);\r\n  background: var(--accent-soft);\r\n}\r\n.stepper { display: flex; align-items: center; gap: 8px; }\r\n.stepper .lbl { font-size: 12.5px; font-weight: 700; color: var(--text-dim); flex: 1; min-width: 0; }\r\n.stepper .val {\r\n  min-width: 78px;\r\n  text-align: center;\r\n  font-family: var(--font-num);\r\n  font-size: 19px;\r\n  font-weight: 700;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n.stepper .pm {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 12px;\r\n  border: 1px solid var(--line);\r\n  background: var(--bg-elev);\r\n  font-size: 21px;\r\n  font-weight: 700;\r\n  line-height: 1;\r\n  color: var(--text);\r\n  flex-shrink: 0;\r\n}\r\n.stepper .pm:active { background: var(--bg-sunk); }\r\n\r\n.col-btns { display: flex; flex-direction: column; gap: 2px; flex-shrink: 0; }\r\n.col-btns .btn { padding: 2px 6px; font-size: 10px; line-height: 1.2; }\r\n\r\n/* לוח מצב הסנכרון */\r\n.sync-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; margin: 4px 0 12px; }\r\n.sync-grid > div { display: flex; flex-direction: column; gap: 1px; min-width: 0; }\r\n.sync-grid .k { font-size: 11px; color: var(--text-faint); font-weight: 700; }\r\n.sync-grid .v { font-size: 13px; font-weight: 600; overflow-wrap: anywhere; }\r\n\r\n/* ---------------------------------------------------------------------------\r\n   אטלס — השיחה\r\n   --------------------------------------------------------------------------- */\r\n.chat { display: flex; flex-direction: column; gap: 10px; min-height: calc(100dvh - var(--header-h) - var(--nav-h) - 24px); padding-top: 12px; }\r\n.chat-list { flex: 1; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; padding-bottom: 8px; scroll-behavior: smooth; }\r\n.chat-date { align-self: center; font-size: 11px; color: var(--text-faint); padding: 2px 10px; border-radius: 999px; background: var(--bg-sunk); margin: 6px 0 2px; }\r\n.bubble {\r\n  max-width: min(78%, 620px);\r\n  padding: 10px 13px;\r\n  border-radius: 16px;\r\n  background: var(--card);\r\n  border: 1px solid var(--line);\r\n  box-shadow: var(--shadow);\r\n  line-height: 1.5;\r\n  font-size: 15px;\r\n}\r\n.bubble.me { align-self: flex-start; background: var(--accent); color: var(--on-accent); border-color: var(--accent); border-end-start-radius: 5px; }\r\n.bubble.atlas { align-self: flex-end; border-end-end-radius: 5px; }\r\n.bubble.failed { opacity: .8; border-color: var(--bad); }\r\n.bubble-text { white-space: pre-wrap; word-break: break-word; }\r\n.bubble-meta { margin-top: 4px; display: flex; justify-content: flex-end; }\r\n.bubble.me .bubble-meta { color: var(--on-accent); opacity: .75; }\r\n.cmds { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line-soft); }\r\n.cmd { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-dim); }\r\n.cmd::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--good); flex: none; }\r\n.bubble.thinking { display: flex; align-items: center; gap: 10px; padding: 8px 12px; }\r\n.dots { display: inline-flex; gap: 4px; }\r\n.dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--text-faint); animation: dot 1.2s infinite ease-in-out; }\r\n.dots i:nth-child(2) { animation-delay: .15s; }\r\n.dots i:nth-child(3) { animation-delay: .3s; }\r\n@keyframes dot { 0%, 80%, 100% { opacity: .25; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }\r\n.chat-empty { margin: auto; text-align: center; max-width: 480px; padding: 24px 8px; }\r\n.chat-empty-mark {\r\n  width: 56px; height: 56px; margin: 0 auto 10px; border-radius: 18px;\r\n  display: grid; place-items: center; font-weight: 900; font-size: 26px;\r\n  background: var(--accent-soft); color: var(--accent);\r\n}\r\n.chat-empty h3 { margin: 0 0 6px; }\r\n.chat-examples { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 14px; }\r\n.chat-examples .chip { cursor: pointer; }\r\n.composer {\r\n  position: sticky; bottom: 0; display: flex; align-items: flex-end; gap: 8px;\r\n  padding: 8px 0 10px; background: var(--bg);\r\n}\r\n.composer .textarea { min-height: 44px; max-height: 160px; resize: none; line-height: 1.4; padding: 11px 12px; }\r\n.icon-btn { width: 44px; height: 44px; padding: 0; display: grid; place-items: center; flex: none; border-radius: 12px; }\r\n.icon-btn svg { width: 22px; height: 22px; }\r\n.mic.on { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); animation: pulse 1.4s infinite; }\r\n@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 var(--bad-soft); } 50% { box-shadow: 0 0 0 6px var(--bad-soft); } }\r\n@media (prefers-reduced-motion: reduce) { .dots i, .mic.on { animation: none; } }\r\n.atlas-card { cursor: pointer; }\r\n@media (min-width: 900px) {\r\n  .chat { min-height: calc(100dvh - 48px); }\r\n}\r\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"app"},["NAV",{"class":"sidebar"},["DIV",{"class":"brand"},["B",{},"מערכת ההפעלה"],["SPAN",{},"יום שישי, 11 בספטמבר"]],["BUTTON",{"aria-current":"true"},["svg",{"class":"ic","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["circle",{"cx":"12","cy":"12","r":"8.2"}],["path",{"d":"M12 7.6V12l2.8 1.7"}]],"היום"],["BUTTON",{"aria-current":"false"},["svg",{"class":"ic","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["circle",{"cx":"12","cy":"12","r":"8.4"}],["path",{"d":"M12 6.6l1.7 3.7 3.7 1.7-3.7 1.7L12 17.4l-1.7-3.7-3.7-1.7 3.7-1.7z"}]],"אטלס"],["BUTTON",{"aria-current":"false"},["svg",{"class":"ic","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["rect",{"x":"3.6","y":"5.2","width":"16.8","height":"15.2","rx":"2.6"}],["path",{"d":"M3.6 10h16.8M8.4 3.6v3.2M15.6 3.6v3.2"}]],"יומן"],["BUTTON",{"aria-current":"false"},["svg",{"class":"ic","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"1.7","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","focusable":"false"},["rect",{"x":"3.4","y":"4.6","width":"6.2","height":"14.8","rx":"1.8"}],